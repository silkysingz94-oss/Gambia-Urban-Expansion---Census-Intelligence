# Use a private PostgreSQL connection string. Never commit real credentials.
DATABASE_URL=postgresql://census_reader:CHANGE_ME@localhost:5432/gambia_census
# Comma-separated trusted dashboard origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8080
# Optional bearer token for protected API deployments; prefer an identity-aware proxy for public browser access.
API_BEARER_TOKEN=
